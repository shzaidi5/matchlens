# Copy to .env. Leave everything unset to run on the built-in template narrator.

# Microsoft Foundry project (preferred). Sign in first with: az login
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<your-model-deployment-name>

# Alternative: a plain Azure OpenAI resource (used only if the Foundry values are unset).
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>
# AZURE_OPENAI_API_KEY=
